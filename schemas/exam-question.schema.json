{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exam-question.schema.json",
  "title": "Eine Prüfungsfrage (Element von exams/questions.json)",
  "description": "Pflicht ist, was eine Frage überhaupt brauchbar macht (ID, Quelle, Datum, Originalwortlaut). Empfohlene Felder (sections, task_types, competencies, points) meldet `validate` als Warnung, wenn sie fehlen; `points: null` bedeutet 'Punktzahl unbekannt'.",
  "type": "object",
  "required": ["id", "source", "date", "text"],
  "properties": {
    "id": {"type": "string", "pattern": "^frage-\\d{4}-\\d{2}-\\d{2}-\\d+$", "description": "frage-<Prüfungsdatum>-<laufende Nummer>"},
    "source": {"type": "string", "minLength": 1, "description": "Quellen-ID aus sources/manifest.yaml"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "number": {"type": ["integer", "string", "null"]},
    "text": {"type": "string", "minLength": 3, "description": "Originalwortlaut, unverändert"},
    "points": {"type": ["number", "null"], "minimum": 0},
    "topic": {"type": ["string", "null"]},
    "topics": {"type": "array", "items": {"type": "string"}},
    "sections": {"type": "array", "items": {"type": "string", "pattern": "^(\\d+(\\.\\d+)*|L\\d+)$"}},
    "figures": {"type": "array", "items": {"type": "string", "pattern": "^(abb|tab|formel)-[a-z0-9][a-z0-9-]*$"}},
    "task_types": {
      "type": "array",
      "items": {"enum": ["definition", "verstaendnis", "aufzaehlung", "erklaerung", "vergleich", "berechnung", "zeichnung"]},
      "uniqueItems": true
    },
    "competencies": {"type": "array", "items": {"type": "string"}},
    "trust": {"type": "string"},
    "notes": {"type": ["string", "null"]}
  },
  "examples": [
    {
      "id": "frage-2026-04-29-1",
      "source": "klausur-2026-04-29",
      "date": "2026-04-29",
      "number": 1,
      "text": "Zeichnen und erläutern Sie den Produktlebenszyklus.",
      "points": 6,
      "topic": "Produktlebenszyklus",
      "sections": ["2.5"],
      "figures": ["abb-08"],
      "task_types": ["zeichnung", "erklaerung"],
      "competencies": ["zeichnen", "erklaeren"]
    }
  ]
}
